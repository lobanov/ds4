"""Helper utilities for batch reporting task: top k frequent elements."""
from __future__ import annotations

def top_k_frequent(nums: list[int], k: int) -> list[int]:
    """Return the k most frequent elements in nums.

    Frequencies are counted; ties are broken by ascending integer value.
    The result list is ordered by decreasing frequency (and ascending value
    for ties).  This matches the repository convention of deterministic
    ordering when frequencies tie.
    """
    # Count frequencies
    freq: dict[int, int] = {}
    for x in nums:
        freq[x] = freq.get(x, 0) + 1

    # Sort by (-frequency, value) to get deterministic order
    sorted_items = sorted(freq.items(), key=lambda item: (-item[1], item[0]))

    # Return the first k elements (only the values)
    return [val for val, _ in sorted_items[:k]]


