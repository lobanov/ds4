```python
"""Return the k most frequent elements from a list of integers.

Uses frequency counting and deterministic sorting: descending frequency,
then ascending value for ties.  No external dependencies.
"""
from __future__ import annotations

def top_k_frequent(nums: list[int], k: int) -> list[int]:
    """Return the k most frequent elements in nums.

    When frequencies tie, smaller values come first.
    """
    # Count frequencies
    freq: dict[int, int] = {}
    for x in nums:
        freq[x] = freq.get(x, 0) + 1

    # Sort by (-frequency, value) for deterministic order
    sorted_items = sorted(freq.items(), key=lambda item: (-item[1], item[0]))

    # Take the first k elements
    return [val for val, _ in sorted_items[:k]]


# --- compact tests -----------------------------------------------------------
def test_top_k_frequent_basic() -> None:
    assert top_k_frequent([1, 1, 1, 2, 2, 3], 2) == [1, 2]

def test_top_k_frequent_tie() -> None:
    # frequencies: 1->2, 2->2, 3->1 → top 2 should be 1 and 2 (ascending)
    assert top_k_frequent([1, 1, 2, 2, 3], 2) == [1, 2]

def test_top_k_frequent_single() -> None:
    assert top_k_frequent([4, 4, 4, 5, 5, 6], 1) == [4]

