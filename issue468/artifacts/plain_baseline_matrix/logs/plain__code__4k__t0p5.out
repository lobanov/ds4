"""Return the k most frequent elements from a list of integers."""
from __future__ import annotations

def top_k_frequent(nums: list[int], k: int) -> list[int]:
    """
    Return the k most frequent elements from nums.

    When frequencies tie, smaller values come first.
    """
    if k <= 0 or not nums:
        return []

    # count frequencies
    freq: dict[int, int] = {}
    for x in nums:
        freq[x] = freq.get(x, 0) + 1

    # sort by (-frequency, value) for deterministic ties
    sorted_items = sorted(freq.items(), key=lambda item: (-item[1], item[0]))

