"""Helper utility for top-k frequent elements extraction.

Follows repository conventions: plain dict/list data, no custom classes,
deterministic tie-breaking (ascending integer order).
"""

from __future__ import annotations

def top_k_frequent(nums: list[int], k: int) -> list[int]:
    """Return the k most frequent elements from nums.

    Frequencies are counted; ties are broken by ascending value.
    The result list is ordered by decreasing frequency, then by value.
    """
    # Count frequencies
    freq: dict[int, int] = {}
    for num in nums:
        freq[num] = freq.get(num, 0) + 1

    # Sort by (-frequency, value) for deterministic order
    sorted_items = sorted(freq.items(), key=lambda x: (-x[1], x[0]))

    # Take first k elements
    return [num for num, _ in sorted_items[:k]]


