"""Helper utilities for top-k frequency extraction."""
from __future__ import annotations

def top_k_frequent(nums: list[int], k: int) -> list[int]:
    """Return the k most frequent elements from nums.

    Frequencies are counted with a plain dict.  When two elements have
    the same frequency, the smaller value comes first (deterministic
    order).  The result list is sorted by decreasing frequency and then
    by value.
    """
    freq: dict[int, int] = {}
    for x in nums:
        freq[x] = freq.get(x, 0) + 1

    # Build list of (value, count) pairs and sort by (-count, value)
    pairs = [(val, cnt) for val, cnt in freq.items()]
    pairs.sort(key=lambda p: (-p[1], p[0]))

    # Return the first k values
    return [val for val, _ in pairs[:k]]


# --- compact tests ------------------------------------------------------
def test_top_k_frequent_basic():
    result = top_k_frequent([1, 1, 1, 2, 2, 3], 2)
    assert result == [1, 2], f"expected [1, 2], got {result}"

