```python
"""Helper utility for top-k frequent elements extraction."""
from __future__ import annotations
from collections import Counter

def top_k_frequent(nums: list[int], k: int) -> list[int]:
    """
    Return the k most frequent elements in nums.
    Ties are broken by ascending element value (deterministic order).
    """
    if not nums or k <= 0:
        return []
    counts = Counter(nums)
    # Sort by (-count, value) for deterministic order
    sorted_items = sorted(counts.items(), key=lambda x: (-x[1], x[0]))
    return [item[0] for item in sorted_items[:k]]
```

